# Public base URL of the deployed site (used for SEO / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact form (Resend) ----
# Your Resend API key. Without it, submissions are logged instead of emailed.
RESEND_API_KEY=
# Inbox that should receive contact-form enquiries.
LEAD_TO_EMAIL=hello@gossanventures.com
# Verified sender. Use a domain you've verified in Resend, e.g.
# "Gossan Ventures <leads@gossanventures.com>". Defaults to Resend's
# onboarding sender (test-only: delivers solely to your own Resend account email).
LEAD_FROM_EMAIL=
