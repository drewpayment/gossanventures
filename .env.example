# ---- Payload CMS ----
# A long, random secret used to encrypt sessions / tokens.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# MongoDB connection string (e.g. MongoDB Atlas).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/gossan?retryWrites=true&w=majority
DATABASE_URI=mongodb://127.0.0.1/gossan

# ---- Site ----
# Public base URL of the deployed site (used for SEO / OG metadata + Payload CORS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
